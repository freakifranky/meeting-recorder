{
  "manifest_version": 3,
  "name": "Meeting Recorder",
  "version": "1.3",
  "description": "Records your mic and a tab's call audio as separate tracks, then transcribes with You / Others labels.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Meeting Recorder",
    "default_popup": "popup.html"
  }
}